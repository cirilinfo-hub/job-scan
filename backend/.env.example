NODE_ENV=development
PORT=4000
# Public origin of the web app, used for links in emails and CORS. Comma-separate extra CORS origins.
APP_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200
TRUST_PROXY=0
# Set to true when Express should also serve the Angular build (single-app hosting)
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist/frontend/browser

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rolewise
DB_PASSWORD=change-me
DB_NAME=rolewise
DB_POOL_SIZE=10

# Required: at least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Private resume storage. Must be outside any public web directory.
STORAGE_DIR=./storage
MAX_UPLOAD_MB=5

# AI (optional). none | anthropic | openai-compatible
AI_PROVIDER=none
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# Optional cost estimate in USD per million tokens; used for admin cost monitoring
AI_COST_INPUT_PER_MTOK=
AI_COST_OUTPUT_PER_MTOK=

# Job sources (optional). Adzuna needs its own keys: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Email (optional). Without SMTP_HOST, emails are written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Rolewise <no-reply@example.com>

# First super admin, used only by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

LOG_LEVEL=info
SCHEDULER_ENABLED=true
RETENTION_DAYS_DELETED=30
RETENTION_DAYS_LOGS=180
